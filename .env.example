# ==============================================================================
# DeutschCoach (Phase 0) — Sample Environment Configuration
# Copy to `.env` and fill in your values before starting the bot.
# NEVER commit `.env` or real credentials/card numbers to version control.
# ==============================================================================

# --- Required Credentials ---
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# --- Admin & Notifications ---
# Comma-separated Telegram numeric user IDs allowed to run admin/QA commands
ADMIN_USER_IDS=
# Telegram numeric chat/user ID to receive diagnostic & payment proof alerts
ADMIN_NOTIFY_CHAT_ID=

# --- Payment / Founder-Beta Offer (Optional) ---
# Primary payment URL (ZarinLink) and/or Card-to-Card fallback details
ZARINLINK_URL=
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_HOLDER=
FOUNDER_SUPPORT_HANDLE=

# --- Model, Pricing & Guardrails ---
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x thinking level: low, medium, or high (GEMINI_THINKING_BUDGET applies to 2.5 models)
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=512
GEMINI_TIMEOUT_SEC=60
USD_TO_TOMAN_RATE=273000
BETA_PACK_PRICE_TOMAN=490000
REGULAR_PACK_PRICE_TOMAN=790000
RESERVATION_TTL_SEC=180
MAX_BILLED_FAILED_ATTEMPTS=2

# --- Runtime Paths & Logging ---
# In Docker Compose, DATA_DIR=/app/data and TMP_AUDIO_DIR=/app/tmp_audio are pinned
DATA_DIR=./data
TMP_AUDIO_DIR=./tmp_audio
LOG_LEVEL=INFO
